rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuth();
    }

    // ── Enforcement de rol Administrador (defensa en profundidad) ─────────────
    // Hoy la app valida el rol solo en el cliente. Para exigirlo también en el
    // servidor, define un custom claim `admin` en el token (vía Cloud Function
    // con admin.auth().setCustomUserClaims(uid, { admin: true })) y cambia los
    // `write: if isStaff()` de las colecciones gestion_* por `write: if isAdmin()`.
    // Se deja preparado pero NO activado para no bloquear a los usuarios actuales
    // hasta que se hayan emitido los claims.
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    // ── Citas ────────────────────────────────────────────────────
    match /citas/{citaId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    // ── Planilla diaria / Caja ───────────────────────────────────
    // Misma postura que citas/pacientes (write abierto) para permitir el
    // autoguardado y la importación sin sesión real. TODO: cambiar write a
    // isStaff()/isAdmin() cuando el login real esté operativo.
    match /planillas/{jornadaId} {
      allow read: if true;
      allow write: if true;
    }
    match /planillas_meta/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Generador de PDF (Imágenes a PDF) ────────────────────────
    match /generadorPdf/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Resultados (informes eco) ────────────────────────────────
    match /resultados/{resultadoId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if false;
    }

    // ── Profesionales ────────────────────────────────────────────
    match /profesionales/{uid} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ── Horarios y bloqueos ──────────────────────────────────────
    match /horarios/{profId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bloqueos/{bloqueoId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Usuarios / Pacientes ─────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    match /users/{uid}/legal/{document} {
      allow read, write: if true;
    }

    // ── Tipos de atención (legado) ───────────────────────────────
    match /tiposAtencion/{tipoId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Asignaciones de turno ────────────────────────────────────
    match /asignaciones/{asigId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Imágenes ─────────────────────────────────────────────────
    match /imagenes/{imagenId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // ── Colecciones de gestión interna ───────────────────────────
    match /gestion_especialidades/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gestion_previsiones/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gestion_prestaciones/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gestion_metodos_pago/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gestion_sexos/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gestion_protocolos/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /plantillas_eco/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Usuarios staff (dashboard) ───────────────────────────────
    match /usuarios/{uid} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pacientes/{pacId} {
      allow read: if true;
      allow write: if true;
    }

    match /retiros_laboratorio/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // ── Toma de Muestras (órdenes y retiros) ─────────────────────
    match /setm_ordenes/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /setm_retiros/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /registro_temperatura/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Misma postura que pacientes/users/citas: lectura/escritura abiertas
    // mientras la app no tenga sesión Firebase real (login anónimo deshabilitado).
    // TODO: cerrar a isStaff()/isAdmin() cuando el login real esté operativo.
    match /fichas_clinicas/{rut} {
      allow read: if true;
      allow write: if true;

      // Evoluciones (consultas por fecha) y documentos emitidos (licencias/recetas)
      match /{subcoleccion}/{docId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
